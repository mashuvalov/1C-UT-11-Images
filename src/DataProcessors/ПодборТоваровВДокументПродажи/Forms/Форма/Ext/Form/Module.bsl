&НаКлиенте
Процедура Расш_Шувалов_СписокПриАктивизацииСтрокиПосле(Элемент)

	// Не грузим картинку синхронно и обновляем только последнюю активную строку.
	Попытка
		ОтключитьОбработчикОжидания("Расш_Шувалов_ОбновитьКартинкуТекущейСтроки");
	Исключение
	КонецПопытки;

	ПодключитьОбработчикОжидания("Расш_Шувалов_ОбновитьКартинкуТекущейСтроки", 0.2, Истина);

КонецПроцедуры

&НаКлиенте
Процедура Расш_Шувалов_ОбновитьКартинкуТекущейСтроки()

	Номенклатура = Расш_Шувалов_ПолучитьТекущуюНоменклатуруПодбора();

	Если Номенклатура = Неопределено Тогда
		Расш_Шувалов_АдресКартинкиТовара = "";
		Расш_Шувалов_ПоследняяНоменклатураКартинки = Справочники.Номенклатура.ПустаяСсылка();
		Возврат;
	КонецЕсли;

	Если Расш_Шувалов_ПоследняяНоменклатураКартинки = Номенклатура Тогда
		Возврат;
	КонецЕсли;

	Расш_Шувалов_ПоследняяНоменклатураКартинки = Номенклатура;
	Расш_Шувалов_АдресКартинкиТовара = Расш_Шувалов_ПолучитьАдресКартинкиТовараНаСервере(Номенклатура);

КонецПроцедуры

&НаКлиенте
Функция Расш_Шувалов_ПолучитьТекущуюНоменклатуруПодбора()

	ИмяСпискаНоменклатуры = "";

	Попытка
		ИмяСпискаНоменклатуры = ПодборТоваровКлиентСервер.ИмяСпискаНоменклатурыПоВариантуПоиска(ЭтаФорма);
	Исключение
		// Если в релизе нет этого метода, ниже используется имя списка по умолчанию.
	КонецПопытки;

	Если НЕ ЗначениеЗаполнено(ИмяСпискаНоменклатуры) Тогда
		// При необходимости заменить на реальное имя элемента списка на форме:
		// СписокНоменклатуры, Список, РезультатыПоиска и т.п.
		ИмяСпискаНоменклатуры = "СписокНоменклатуры";
	КонецЕсли;

	Если Элементы.Найти(ИмяСпискаНоменклатуры) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЭлементСписка = Элементы[ИмяСпискаНоменклатуры];

	Если ЭлементСписка.ТекущаяСтрока = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(ЭлементСписка.ТекущаяСтрока) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТекущиеДанные = ЭлементСписка.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Номенклатура = Расш_Шувалов_ПолучитьНоменклатуруИзТекущихДанных(ТекущиеДанные);

	Если ТипЗнч(Номенклатура) <> Тип("СправочникСсылка.Номенклатура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Номенклатура.Пустая() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Номенклатура;

КонецФункции

&НаКлиенте
Функция Расш_Шувалов_ПолучитьНоменклатуруИзТекущихДанных(ТекущиеДанные)

	Попытка
		Если ЗначениеЗаполнено(ТекущиеДанные.Ссылка) Тогда
			Возврат ТекущиеДанные.Ссылка;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		Если ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда
			Возврат ТекущиеДанные.Номенклатура;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

&НаСервере
Функция Расш_Шувалов_ПолучитьАдресКартинкиТовараНаСервере(НоменклатураСсылка)

	Если НоменклатураСсылка = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если НоменклатураСсылка.Пустая() Тогда
		Возврат "";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура.ФайлКартинки КАК ФайлКартинки
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка = &Ссылка";

	Запрос.УстановитьПараметр("Ссылка", НоменклатураСсылка);

	Выборка = Запрос.Выполнить().Выбрать();

	Если НЕ Выборка.Следующий() Тогда
		Возврат "";
	КонецЕсли;

	ФайлКартинки = Выборка.ФайлКартинки;

	Если НЕ ЗначениеЗаполнено(ФайлКартинки) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		ДанныеФайла = ПрисоединенныеФайлы.ПолучитьДанныеФайла(
			ФайлКартинки,
			ЭтаФорма.УникальныйИдентификатор
		);

		Возврат ДанныеФайла.СсылкаНаДвоичныеДанныеФайла;
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции
