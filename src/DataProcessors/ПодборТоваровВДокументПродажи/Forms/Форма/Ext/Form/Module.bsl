&НаКлиенте
Процедура Расш_Шувалов_ПроверитьКартинку(Команда)

	Сообщить("[КартинкаПодбора] Ручная проверка: команда сработала.");
	Расш_Шувалов_ОбновитьКартинкуТекущейСтроки();

КонецПроцедуры

&НаКлиенте
Процедура Расш_Шувалов_ПриОткрытииПосле(Отказ)

	Расш_Шувалов_СообщитьОтладку("ПриОткрытии: включаем периодическое обновление картинки.");

	Попытка
		ОтключитьОбработчикОжидания("Расш_Шувалов_ОбновитьКартинкуТекущейСтроки");
	Исключение
	КонецПопытки;

	// Периодический режим: обновление само проверит, изменилась ли номенклатура.
	ПодключитьОбработчикОжидания("Расш_Шувалов_ОбновитьКартинкуТекущейСтроки", 1, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура Расш_Шувалов_ПриЗакрытииПосле(ЗавершениеРаботы)

	Попытка
		ОтключитьОбработчикОжидания("Расш_Шувалов_ОбновитьКартинкуТекущейСтроки");
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура Расш_Шувалов_СписокПриАктивизацииСтрокиПосле(Элемент)

	Расш_Шувалов_СообщитьОтладку("ПриАктивизацииСтроки: обработчик сработал.");

	Попытка
		Расш_Шувалов_СообщитьОтладку("ПриАктивизацииСтроки: имя элемента = " + Элемент.Имя);
	Исключение
		Расш_Шувалов_СообщитьОтладку("ПриАктивизацииСтроки: не удалось получить имя элемента: " + ОписаниеОшибки());
	КонецПопытки;

	// Не грузим картинку синхронно и обновляем только последнюю активную строку.
	Попытка
		ОтключитьОбработчикОжидания("Расш_Шувалов_ОбновитьКартинкуТекущейСтроки");
	Исключение
	КонецПопытки;

	ПодключитьОбработчикОжидания("Расш_Шувалов_ОбновитьКартинкуТекущейСтроки", 0.2, Истина);

КонецПроцедуры

&НаКлиенте
Процедура Расш_Шувалов_ОбновитьКартинкуТекущейСтроки()

	Расш_Шувалов_СообщитьОтладку("Обновление картинки: старт.");

	Номенклатура = Расш_Шувалов_ПолучитьТекущуюНоменклатуруПодбора();

	Если Номенклатура = Неопределено Тогда
		Расш_Шувалов_СообщитьОтладку("Обновление картинки: текущая номенклатура не найдена.");
		Расш_Шувалов_АдресКартинкиТовара = "";
		Расш_Шувалов_ПоследняяНоменклатураКартинки = Расш_Шувалов_ПустаяСсылкаНоменклатурыНаСервере();
		Возврат;
	КонецЕсли;

	Расш_Шувалов_СообщитьОтладку("Обновление картинки: номенклатура = " + Строка(Номенклатура));

	Если Расш_Шувалов_ПоследняяНоменклатураКартинки = Номенклатура Тогда
		Расш_Шувалов_СообщитьОтладку("Обновление картинки: та же номенклатура, повторно не загружаем.");
		Возврат;
	КонецЕсли;

	Расш_Шувалов_ПоследняяНоменклатураКартинки = Номенклатура;
	Расш_Шувалов_АдресКартинкиТовара = Расш_Шувалов_ПолучитьАдресКартинкиТовараНаСервере(Номенклатура);

	Если ЗначениеЗаполнено(Расш_Шувалов_АдресКартинкиТовара) Тогда
		Расш_Шувалов_СообщитьОтладку("Обновление картинки: адрес получен.");
	Иначе
		Расш_Шувалов_СообщитьОтладку("Обновление картинки: адрес пустой.");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция Расш_Шувалов_ПолучитьТекущуюНоменклатуруПодбора()

	ИмяСпискаНоменклатуры = "";

	Попытка
		ИмяСпискаНоменклатуры = ПодборТоваровКлиентСервер.ИмяСпискаНоменклатурыПоВариантуПоиска(ЭтаФорма);
	Исключение
		Расш_Шувалов_СообщитьОтладку("Не удалось автоопределить имя списка: " + ОписаниеОшибки());
		// Если в релизе нет этого метода, ниже используется имя списка по умолчанию.
	КонецПопытки;

	Если НЕ ЗначениеЗаполнено(ИмяСпискаНоменклатуры) Тогда
		// При необходимости заменить на реальное имя элемента списка на форме:
		// СписокНоменклатуры, Список, РезультатыПоиска и т.п.
		ИмяСпискаНоменклатуры = Расш_Шувалов_ИмяДоступногоСпискаНоменклатуры();
	КонецЕсли;

	Расш_Шувалов_СообщитьОтладку("Имя списка номенклатуры = " + ИмяСпискаНоменклатуры);

	Если Элементы.Найти(ИмяСпискаНоменклатуры) = Неопределено Тогда
		ИмяСпискаНоменклатуры = Расш_Шувалов_ИмяДоступногоСпискаНоменклатуры();

		Если Элементы.Найти(ИмяСпискаНоменклатуры) = Неопределено Тогда
			Расш_Шувалов_СообщитьОтладку("Элемент списка не найден. Доступные элементы: " + Расш_Шувалов_ИменаЭлементовФормы());
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;

	ЭлементСписка = Элементы[ИмяСпискаНоменклатуры];

	Если ЭлементСписка.ТекущаяСтрока = Неопределено Тогда
		Расш_Шувалов_СообщитьОтладку("У списка нет текущей строки.");
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(ЭлементСписка.ТекущаяСтрока) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
		Расш_Шувалов_СообщитьОтладку("Текущая строка - строка группировки.");
		Возврат Неопределено;
	КонецЕсли;

	ТекущиеДанные = ЭлементСписка.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		Расш_Шувалов_СообщитьОтладку("ТекущиеДанные списка = Неопределено.");
		Возврат Неопределено;
	КонецЕсли;

	Номенклатура = Расш_Шувалов_ПолучитьНоменклатуруИзТекущихДанных(ТекущиеДанные);

	Если ТипЗнч(Номенклатура) <> Тип("СправочникСсылка.Номенклатура") Тогда
		Расш_Шувалов_СообщитьОтладку("Из текущих данных не получена ссылка на номенклатуру. Тип = " + Строка(ТипЗнч(Номенклатура)));
		Возврат Неопределено;
	КонецЕсли;

	Если Номенклатура.Пустая() Тогда
		Расш_Шувалов_СообщитьОтладку("Получена пустая ссылка номенклатуры.");
		Возврат Неопределено;
	КонецЕсли;

	Возврат Номенклатура;

КонецФункции

&НаКлиенте
Функция Расш_Шувалов_ИмяДоступногоСпискаНоменклатуры()

	Если Элементы.Найти("СписокРасширенныйПоискНоменклатура") <> Неопределено Тогда
		Возврат "СписокРасширенныйПоискНоменклатура";
	КонецЕсли;

	Если Элементы.Найти("СписокСтандартныйПоискНоменклатура") <> Неопределено Тогда
		Возврат "СписокСтандартныйПоискНоменклатура";
	КонецЕсли;

	Если Элементы.Найти("СписокНоменклатуры") <> Неопределено Тогда
		Возврат "СписокНоменклатуры";
	КонецЕсли;

	Возврат "СписокСтандартныйПоискНоменклатура";

КонецФункции

&НаКлиенте
Функция Расш_Шувалов_ПолучитьНоменклатуруИзТекущихДанных(ТекущиеДанные)

	Попытка
		Если ЗначениеЗаполнено(ТекущиеДанные.Ссылка) Тогда
			Возврат ТекущиеДанные.Ссылка;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		Если ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда
			Возврат ТекущиеДанные.Номенклатура;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

&НаКлиенте
Функция Расш_Шувалов_ИменаЭлементовФормы()

	Имена = "";

	Попытка
		Для Каждого ЭлементФормы Из Элементы Цикл
			Если ЗначениеЗаполнено(Имена) Тогда
				Имена = Имена + ", ";
			КонецЕсли;

			Имена = Имена + ЭлементФормы.Имя;
		КонецЦикла;
	Исключение
		Имена = "не удалось получить список элементов: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Имена;

КонецФункции

&НаКлиенте
Процедура Расш_Шувалов_СообщитьОтладку(ТекстСообщения)

	Если НЕ Расш_Шувалов_ОтладкаКартинкиПодбора() Тогда
		Возврат;
	КонецЕсли;

	Сообщить("[КартинкаПодбора] " + ТекстСообщения);

КонецПроцедуры

&НаКлиенте
Функция Расш_Шувалов_ОтладкаКартинкиПодбора()

	Возврат Ложь;

КонецФункции

&НаСервере
Процедура Расш_Шувалов_СообщитьОтладкуНаСервере(ТекстСообщения)

	Если НЕ Расш_Шувалов_ОтладкаКартинкиПодбораНаСервере() Тогда
		Возврат;
	КонецЕсли;

	Сообщить("[КартинкаПодбора] " + ТекстСообщения);

КонецПроцедуры

&НаСервере
Функция Расш_Шувалов_ОтладкаКартинкиПодбораНаСервере()

	Возврат Ложь;

КонецФункции

&НаСервере
Функция Расш_Шувалов_ПустаяСсылкаНоменклатурыНаСервере()

	Возврат Справочники.Номенклатура.ПустаяСсылка();

КонецФункции

&НаСервере
Функция Расш_Шувалов_ПолучитьАдресКартинкиТовараНаСервере(НоменклатураСсылка)

	Если НоменклатураСсылка = Неопределено Тогда
		Расш_Шувалов_СообщитьОтладкуНаСервере("Сервер: номенклатура = Неопределено.");
		Возврат "";
	КонецЕсли;

	Если НоменклатураСсылка.Пустая() Тогда
		Расш_Шувалов_СообщитьОтладкуНаСервере("Сервер: номенклатура пустая.");
		Возврат "";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура.ФайлКартинки КАК ФайлКартинки
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка = &Ссылка";

	Запрос.УстановитьПараметр("Ссылка", НоменклатураСсылка);

	Выборка = Запрос.Выполнить().Выбрать();

	Если НЕ Выборка.Следующий() Тогда
		Расш_Шувалов_СообщитьОтладкуНаСервере("Сервер: номенклатура не найдена запросом.");
		Возврат "";
	КонецЕсли;

	ФайлКартинки = Выборка.ФайлКартинки;

	Если НЕ ЗначениеЗаполнено(ФайлКартинки) Тогда
		Расш_Шувалов_СообщитьОтладкуНаСервере("Сервер: у номенклатуры не заполнен ФайлКартинки.");
		Возврат "";
	КонецЕсли;

	Расш_Шувалов_СообщитьОтладкуНаСервере("Сервер: ФайлКартинки = " + Строка(ФайлКартинки));

	Попытка
		ДанныеФайла = РаботаСФайлами.ДанныеФайла(
			ФайлКартинки,
			ЭтаФорма.УникальныйИдентификатор,
			Истина
		);

		Возврат ДанныеФайла.СсылкаНаДвоичныеДанныеФайла;
	Исключение
		Расш_Шувалов_СообщитьОтладкуНаСервере("Сервер: ошибка получения данных файла: " + ОписаниеОшибки());
		Возврат "";
	КонецПопытки;

КонецФункции
